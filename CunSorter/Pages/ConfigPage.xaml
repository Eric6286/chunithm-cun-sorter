<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CunSorter.Pages.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14,18,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,18,28,18">
        <StackPanel Spacing="12">
            <TextBlock Text="目录设置" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource RowCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="截图目录" VerticalAlignment="Center" />
                        <TextBox x:Name="ShotsDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseShots_Click" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出目录" VerticalAlignment="Center" />
                        <TextBox x:Name="OutDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseOut_Click" />
                    </Grid>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="截图目录＝要扫描的原始截图所在文件夹；输出目录＝分类结果的根目录（寸/ 等子文件夹建在这里）。改完点下方「保存配置」或「应用并重新扫描」生效。" />
                </StackPanel>
            </Border>

            <TextBlock Text="判定规则（「寸」统计）" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel x:Name="RuleRows" Spacing="10" />
            <Button Click="AddCustom_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="添加判定规则" />
                </StackPanel>
            </Button>

            <TextBlock Text="整理（移动原图归档）" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource RowCard}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="拖动调整顺序：靠上＝外层文件夹（如「日期」在上、「评级」在下 → 日期文件夹里再按评级分）。启用后扫描会把原始截图「移动」到对应文件夹（不再留在原目录，可还原）。" />
                    <ListView x:Name="OrganizeList" SelectionMode="None"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              HorizontalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4,8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="DGHub 联动" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource RowCard}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="从游戏内存实时读取判定计数（只读，不修改游戏），通过本机 DGHub 触发波形：打歌中 MISS / ATTACK 即时触发；结算时按上面的「寸」判定规则命中即触发。需要 DGHub 主程序在本机运行。改完点「保存配置」立即生效。" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="DgEnabledSw" Grid.Column="0" OnContent="" OffContent="" MinWidth="0" />
                        <TextBlock Grid.Column="1" Text="启用 DGHub 联动" VerticalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="DGHub 地址" MinWidth="84" VerticalAlignment="Center" />
                        <TextBox x:Name="DgHostBox" Width="140" VerticalAlignment="Center" />
                        <TextBlock Text="API 端口" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgPortBox" Width="110" Minimum="0" Maximum="65535"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"
                                   PlaceholderText="见 DGHub" />
                        <TextBlock Text="波形预设" VerticalAlignment="Center" />
                        <TextBox x:Name="DgPresetBox" Width="140" VerticalAlignment="Center" />
                        <TextBlock Text="通道" VerticalAlignment="Center" />
                        <ComboBox x:Name="DgChannelBox" Width="110" VerticalAlignment="Center">
                            <ComboBoxItem Content="双通道" />
                            <ComboBoxItem Content="A 通道" />
                            <ComboBoxItem Content="B 通道" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="实时触发" MinWidth="84" VerticalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Name="DgMissSw" OnContent="" OffContent="" MinWidth="0" />
                        <TextBlock Text="MISS，强度%" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgMissPct" Width="90" Minimum="0" Maximum="100"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="DgAtkSw" OnContent="" OffContent="" MinWidth="0" />
                        <TextBlock Text="ATTACK，强度%" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgAtkPct" Width="90" Minimum="0" Maximum="100"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" />
                        <TextBlock Text="持续(秒)" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgRtDur" Width="90" Minimum="0" Maximum="300"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="结算触发" MinWidth="84" VerticalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Name="DgSettleSw" OnContent="" OffContent="" MinWidth="0" />
                        <TextBlock Text="命中「寸」规则时，强度%" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgSettlePct" Width="90" Minimum="0" Maximum="100"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" />
                        <TextBlock Text="持续(秒)" VerticalAlignment="Center" />
                        <NumberBox x:Name="DgSettleDur" Width="90" Minimum="0" Maximum="300"
                                   SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="SaveBtn" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="保存配置" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanBtn" Style="{ThemeResource AccentButtonStyle}" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Sync" />
                        <TextBlock Text="应用并重新扫描" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenBtn" Click="Open_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" />
                        <TextBlock Text="打开输出文件夹" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CunSorter.Pages.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14,18,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,18,28,18">
        <StackPanel Spacing="12">
            <TextBlock Text="目录设置" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource RowCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="截图目录" VerticalAlignment="Center" />
                        <TextBox x:Name="ShotsDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseShots_Click" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输出目录" VerticalAlignment="Center" />
                        <TextBox x:Name="OutDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseOut_Click" />
                    </Grid>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="截图目录＝要扫描的原始截图所在文件夹；输出目录＝分类结果的根目录（寸/ 等子文件夹建在这里）。改完点下方「保存配置」或「应用并重新扫描」生效。" />
                </StackPanel>
            </Border>

            <TextBlock Text="判定规则（「寸」统计）" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel x:Name="RuleRows" Spacing="10" />
            <Button Click="AddCustom_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="添加判定规则" />
                </StackPanel>
            </Button>

            <TextBlock Text="整理（移动原图归档）" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource RowCard}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="拖动调整顺序：靠上＝外层文件夹（如「日期」在上、「评级」在下 → 日期文件夹里再按评级分）。启用后扫描会把原始截图「移动」到对应文件夹（不再留在原目录，可还原）。" />
                    <ListView x:Name="OrganizeList" SelectionMode="None"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              HorizontalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4,8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="SaveBtn" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="保存配置" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanBtn" Style="{ThemeResource AccentButtonStyle}" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Sync" />
                        <TextBlock Text="应用并重新扫描" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenBtn" Click="Open_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" />
                        <TextBlock Text="打开输出文件夹" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

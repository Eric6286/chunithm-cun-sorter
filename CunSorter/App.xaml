<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CunSorter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 本项目认领的主题色：活力橙 #FF6B35（每个项目一种，表在全局 CLAUDE.md）。
                 不覆盖的话强调色跟着 Windows 个性化设置走，几个 App 摆在一起长得一模一样。
                 Light/Dark 那六档是主色混白 / 混黑 14%、28%、42% 推出来的，别各写各的。 -->
            <Color x:Key="SystemAccentColor">#FFFF6B35</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFF8051</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF946E</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFA98A</Color>
            <Color x:Key="SystemAccentColorDark1">#FFDB5C2E</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB84D26</Color>
            <Color x:Key="SystemAccentColorDark3">#FF943E1F</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF6B35" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF6B35" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF6B35" />
            <!-- 强调色按钮上的字：白字压在这支橙上只有 2.84:1，黑字有 7.41:1 -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF1F0A00" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

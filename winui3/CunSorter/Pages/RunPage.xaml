<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CunSorter.Pages.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="RunCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,12,18,12" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,18,28,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行 / 监视" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- mode -->
        <Border Grid.Row="1" Style="{StaticResource RunCard}">
            <Grid>
                <TextBlock Text="处理模式" VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ModeBox" Width="240" HorizontalAlignment="Right"
                          SelectionChanged="Mode_SelectionChanged">
                    <ComboBoxItem Content="realtime (实时·低优先级)" />
                    <ComboBoxItem Content="on_close (关游戏后处理)" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- status -->
        <Border Grid.Row="2" Style="{StaticResource RunCard}">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button x:Name="StartBtn" Style="{ThemeResource AccentButtonStyle}" Click="Start_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock x:Name="StartText" Text="启动监视" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="WatchLabel" Text="监视: 未启动" VerticalAlignment="Center" />
                <TextBlock x:Name="GameLabel" Text="游戏: 检测中…" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <CheckBox Grid.Row="3" x:Name="AutostartBox" Content="开机自启「今天你寸了吗」"
                  Click="Autostart_Click" />

        <TextBlock Grid.Row="4" Text="最近命中" Style="{ThemeResource BodyStrongTextBlockStyle}" />

        <TextBox Grid.Row="5" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" />
    </Grid>
</Page>

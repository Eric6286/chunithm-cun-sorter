<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CunSorter.Pages.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14,18,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,18,28,18">
        <StackPanel Spacing="12">
            <TextBlock Text="规则设置" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel x:Name="Rows" Spacing="10" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="SaveBtn" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="保存配置" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanBtn" Style="{ThemeResource AccentButtonStyle}" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Sync" />
                        <TextBlock Text="应用并重新扫描" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenBtn" Click="Open_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" />
                        <TextBlock Text="打开输出文件夹" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
